APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# عدد العمليات المتوازية لـ php artisan serve (بدونها يُنفَّذ طلب واحد فقط في كل مرة)
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=6543
# Required with the Supabase transaction pooler (port 6543)
DB_EMULATE_PREPARES=true
# Reuse DB connections across requests (Herd / php-cgi). Keep false for artisan serve.
DB_PERSISTENT=false
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file أسرع بكثير من database عندما تكون قاعدة البيانات بعيدة
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="SolarHub"

OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_MAX_ATTEMPTS=3
OTP_RESEND_DECAY_SECONDS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=
SUPABASE_DEFAULT_REGION=ap-northeast-2
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=private-documents
SUPABASE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/public-media

SOLARHUB_ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3000
SANCTUM_TOKEN_EXPIRATION=10080

# Password for TestAccountsSeeder (local/testing only). Defaults to Test@12345 when empty.
TEST_ACCOUNTS_PASSWORD=
